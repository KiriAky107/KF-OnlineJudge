{
  "$defs": {
    "BoundaryMeasurement": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "format": "uuid",
          "title": "Case Id",
          "type": "string"
        },
        "cpu_time_us": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Cpu Time Us",
          "type": "integer"
        },
        "memory_peak_bytes": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Memory Peak Bytes",
          "type": "integer"
        },
        "outcome": {
          "enum": [
            "completed",
            "runtime_error",
            "time_limit",
            "memory_limit",
            "output_limit",
            "other_limit"
          ],
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "outcome",
        "cpu_time_us",
        "memory_peak_bytes"
      ],
      "title": "BoundaryMeasurement",
      "type": "object"
    },
    "LeaseBinding": {
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "format": "uuid",
          "title": "Attempt Id",
          "type": "string"
        },
        "evaluation_id": {
          "format": "uuid",
          "title": "Evaluation Id",
          "type": "string"
        },
        "fencing_version": {
          "maximum": 9223372036854775807,
          "minimum": 1,
          "title": "Fencing Version",
          "type": "integer"
        },
        "worker_id": {
          "format": "uuid",
          "title": "Worker Id",
          "type": "string"
        }
      },
      "required": [
        "evaluation_id",
        "attempt_id",
        "worker_id",
        "fencing_version"
      ],
      "title": "LeaseBinding",
      "type": "object"
    }
  },
  "$id": "urn:kf-oj:diagnostic-boundary-measurements:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "binding": {
      "$ref": "#/$defs/LeaseBinding"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/BoundaryMeasurement"
      },
      "maxItems": 4,
      "minItems": 2,
      "title": "Cases",
      "type": "array"
    },
    "kind": {
      "const": "diagnostic.boundary-measurements",
      "title": "Kind",
      "type": "string"
    },
    "manifest_digest": {
      "maxLength": 64,
      "minLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "binding",
    "manifest_digest",
    "cases"
  ],
  "title": "DiagnosticBoundaryReport",
  "type": "object"
}
