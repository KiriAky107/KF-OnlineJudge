{
  "$id": "urn:kf-oj:delivery-availability:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "configuration_id": {
      "pattern": "^cfg-[0-9a-f]{24}$",
      "title": "Configuration Id",
      "type": "string"
    },
    "release_id": {
      "pattern": "^sd-[0-9a-f]{12}$",
      "title": "Release Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "state": {
      "enum": [
        "open",
        "draining",
        "quiescent"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "configuration_id",
    "state"
  ],
  "title": "AvailabilityRecord",
  "type": "object"
}
